# Public demo settings. Copy to deploy/public-demo/.env (gitignored) and replace EVERY value;
# these placeholders only let `docker compose config` validate the file. Never commit the copy.
# Comments must be on their own line.

# Public DNS name the TLS certificate was issued for.
FLOWPILOT_PUBLIC_HOST=demo.example.com
# Where plain HTTP redirects to: https://<host>[:<external HTTPS port>], no trailing slash.
# Defaults to https://FLOWPILOT_PUBLIC_HOST (standard port 443). Set it when the external HTTPS
# port is not 443, e.g. https://localhost:18443 for a local trial.
FLOWPILOT_PUBLIC_ORIGIN=https://demo.example.com
# Directory containing fullchain.pem and privkey.pem (from any CA, or self-signed for a trial).
FLOWPILOT_TLS_DIR=./certs
# Three different secrets. Keys: `uv run flowpilot-admin gen-key`. Reviewer token:
# python3 -c "import secrets; print('fpr_' + secrets.token_urlsafe(32))"
FLOWPILOT_API_KEY=placeholder-admin-key-replace-me-0000000000
FLOWPILOT_CONSOLE_API_KEY=placeholder-console-key-replace-me-111111111
FLOWPILOT_DEMO_REVIEWER_TOKEN=fpr_placeholder-reviewer-token-replace-me-2222
# How often the demo data is rebuilt (seconds, at least 300).
FLOWPILOT_DEMO_REFRESH_SECONDS=3600
FLOWPILOT_LOG_LEVEL=INFO
FLOWPILOT_HTTP_PORT=80
FLOWPILOT_HTTPS_PORT=443
