# FlowPilot AI configuration. Copy to `.env` (gitignored) and fill in values.
# Real environment variables take precedence over values in `.env`.
# Comments must be on their own line: inline comments (KEY=value  # note) are NOT supported and
# would become part of the value.

# REQUIRED. Shared secret for X-API-Key authentication (min 32 characters).
# Generate one with: uv run flowpilot-admin gen-key
FLOWPILOT_API_KEY=

# SQLite database file. Parent directory is created on `migrate`.
FLOWPILOT_DB_PATH=var/flowpilot.db

# Directory for `flowpilot-admin backup` output.
FLOWPILOT_BACKUP_DIR=var/backups

# Bind address. Must be a loopback address (127.0.0.1, ::1, localhost); anything else is rejected.
FLOWPILOT_HOST=127.0.0.1
FLOWPILOT_PORT=8000

# Swagger/ReDoc UIs load assets from a public CDN, so they are disabled by default to keep
# the app free of external network requests. /openapi.json is always served locally.
FLOWPILOT_ENABLE_DOCS=false

# --- Local LLM (M2) ---------------------------------------------------------------------------
# off (default): never call a model; qualification/drafts use deterministic fallbacks.
# ollama: call the local Ollama server below. Verify first with `flowpilot-admin llm-check`.
FLOWPILOT_LLM_MODE=off

# Must be a loopback http(s) URL with no path; anything else is rejected at startup.
FLOWPILOT_OLLAMA_URL=http://127.0.0.1:11434

# Must already be installed (`ollama list`); FlowPilot never downloads models.
# License note: see README "Model licensing" before any non-demo use.
FLOWPILOT_LLM_MODEL=qwen2.5:3b

# Per-request read timeout in seconds (5-180). The first call also loads the model into memory.
FLOWPILOT_LLM_TIMEOUT_S=60
